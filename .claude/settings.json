{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git branch)",
      "Bash(git branch -a:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(npm ci)",
      "Bash(npm run:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx jest:*)",
      "Bash(npx expo lint:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)"
    ]
  }
}
